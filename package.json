{
  "name": "local-codex-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy dist --config wrangler.pages.jsonc",
    "format": "prettier --write src tests e2e *.ts *.json *.jsonc README.md",
    "format:check": "prettier --check src tests e2e *.ts *.json *.jsonc README.md"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.4",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.45.0"
  }
}
